{
  "name": "yummy-tummy",
  "private": true,
  "version": "2.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "expo start",
    "mobile": "expo start",
    "build:backend": "tsc -p backend/tsconfig.json",
    "server": "npm run build:backend && node backend/dist/main.js",
    "backend": "npm run build:backend && node backend/dist/main.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "tsc --noEmit && tsc -p backend/tsconfig.json --noEmit",
    "test:frontend": "tsx --test test/*.test.ts",
    "test:backend": "tsx --tsconfig backend/tsconfig.json --test backend/test/*.test.ts",
    "test": "npm run lint && npm run test:frontend && npm run test:backend"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@google/genai": "^2.4.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-fastify": "^12.0.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.102.8",
    "dotenv": "^17.2.3",
    "expo": "~57.0.20",
    "expo-auth-session": "~57.0.11",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "^57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-haptics": "^57.0.2",
    "expo-image": "^57.0.4",
    "expo-linking": "^57.0.9",
    "expo-router": "^57.0.19",
    "expo-status-bar": "^57.0.1",
    "fastify": "^5.12.3",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "lucide-react-native": "^1.40.0",
    "mongoose": "^9.9.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  }
}
