# Server Environment Configuration
PORT=3000
NODE_ENV=development

# MongoDB Atlas Database URI (Never exposed to mobile app)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/yummy-tummy?retryWrites=true&w=majority"

# Gemini API Key (Server-side intent parsing, substitutions, and cooking assistant)
GEMINI_API_KEY=""

# YouTube Data API v3 Key (Server-side tutorial lookup with MongoDB caching & ranking)
YOUTUBE_API_KEY=""

# Firebase Admin SDK Credentials (JWT Verification on Backend)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Optional Monitoring & Sentry
SENTRY_DSN=""

# Mobile Client API Base URL (Expo environment variable)
EXPO_PUBLIC_API_URL="http://localhost:3000"

# Firebase WEB app config for in-app Email/Google sign-in (Expo environment variables)
# These differ from the Admin SDK credentials above - copy them from Firebase Console >
# Project settings > Your apps > Web app (apiKey + projectId). Required for auth to work.
EXPO_PUBLIC_FIREBASE_API_KEY=""
EXPO_PUBLIC_FIREBASE_PROJECT_ID=""
