    "@nestjs/platform-fastify": "^12.0.1",
    "dotenv": "^17.2.3",
    "fastify": "^5.12.3",
    "firebase-admin": "^14.3.0",
    "mongoose": "^9.9.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
